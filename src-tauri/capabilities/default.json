{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "星穹铁道跃迁点名器桌面壳权限：仅核心窗口能力（无导出需求，不装 dialog/fs 插件）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/**" }
      ]
    }
  ]
}
